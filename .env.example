# ============================================
# G-Architects HRMS - Environment Variables
# Copy this to .env and fill in the values
# ============================================

# Database (Required)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# JWT Authentication (Required)
JWT_SECRET=your-random-secret-key-here
JWT_EXPIRES_IN=7d

# Server (Optional)
PORT=3000
# Timezone used for date rollovers (attendance auto-mark etc.)
TIMEZONE=Asia/Kolkata
# Pool size for local/VM postgres (serverless uses 1 automatically)
PGPOOL_MAX=5

# CORS - Allowed Origins (Optional)
ALLOWED_ORIGINS=https://garchitects.in,https://www.garchitects.in

# Supabase Storage (Required for file uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Email SMTP (Required for sending emails)
# For Gmail: SMTP_USER = the gmail address, SMTP_PASS = an App Password
# (16 chars, generated at https://myaccount.google.com/apppasswords with
# 2-Step Verification enabled; not the account password).
# Verify with: npm run test:smtp -- <recipient@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Optional - shown as sender. For Gmail this address must be added as a
# "Send mail as" alias in the SMTP account, otherwise Gmail overrides it.
SMTP_FROM=your-email@gmail.com

# App URL (Optional - used in email links)
APP_URL=https://garchitects.in

# Push Notifications (Optional)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@gmail.com

# Cron Job Secret (Optional - guards /api/cron/*)
CRON_SECRET=your-cron-secret

# Admin seed (used by server/scripts/seed-admin.js - never commit a real password)
ADMIN_EMPLOYEE_ID=GA0001
ADMIN_EMAIL=admin@garchitects.com
ADMIN_PASSWORD=your-password

# Node Environment
NODE_ENV=production